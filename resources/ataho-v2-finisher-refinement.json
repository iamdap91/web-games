  "changes": {
    "finisher-demon": "긴 앞 먹획·붉은 평행획·테두리·끝 타원 삭제. 짧은 종이면·원본 실루엣·작은 먹점으로 정리.",
    "finisher-omnislash-v5": "도착 사각 틈 삭제. 첫5타 보존, 끝타는 지상 재등장·300ms 장전·동쪽 어퍼컷·가드. 마지막 틀 파열 유지.",
    "finisher-drunken-tiger": "몸을 따라가는 노란 타원호·곡선·종결 고리 삭제, 실제 비접촉 완급 재분배 유지.",
    "finisher-ryuko-ranbu": "후반 고속 난무에만40ms 간격·90/130ms 수명·옅은2~3겹. 임의 위치·재겹침·끝 수직방출 삭제.",
    "finisher-phoenix": "지상회전1→공중3→무접촉 뒤돌기·착지·재진입→공중3→장전 끝각1. 날개·깃털·큰 면 제거.",
    "finisher-galactica-phantom": "장전→150ms 접근→1170ms 한 접촉→95ms 관통→표적 뒤 정지→그 자리 회수. 수평 띠·진행 파면 제거."
  },
  "targetReaction": {
    "target": "현재 조합실 샌드백이며 적 캐릭터 그림·본게임 전투를 추가하지 않는다.",
    "owner": "step.contact의 strength/reactionHold 데이터와 sandbag의 절대 시각 샘플링",
    "connectedOnly": true,
    "galacticaHoldStartMs": 1170,
    "galacticaHoldEndMs": 2385,
    "hiddenWhen": ["showMovement=false", "showSandbag=false"],
    "contactVfxOff": "피격 유지는 유지하고 접촉 장식만 숨긴다.",
